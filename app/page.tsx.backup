  { value: "4.9", label: "Marketplace rating" },
];

const appFeatures = [
  {
    icon: "fa-solid fa-wand-magic-sparkles",
    title: "Personalised drops",
    description: "Get notified when sellers list pieces that match your saved aesthetics.",
  },
  {
    icon: "fa-solid fa-camera",
    title: "Fast listing tools",
    description: "Shoot, tag, and publish listings in under 90 seconds with smart autofill.",
  },
  {
    icon: "fa-solid fa-comments",
    title: "Chat & offers",
    description: "Negotiate respectfully, bundle items, and lock deals in-app.",
  },
];

const marqueeItems = [
  "Authentic Sellers",
  "Weekly Drops",
  "Style More Spend Less",
  "Circular Wardrobe",
  "Premium Curation",
  "Impact Tracker",
];

const trendingFallbacks = [
  "https://images.unsplash.com/photo-1612423284934-2850a4ac8603?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1514996937319-344454492b37?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=900&q=80",
  "https://images.unsplash.com/photo-1489515217757-5fd1be406fef?auto=format&fit=crop&w=900&q=80",
];

export default function HomePage() {
  const [currentSlide, setCurrentSlide] = useState(0);
  const [isMounted, setIsMounted] = useState(false);

  useEffect(() => {
    setIsMounted(true);
    const timer = window.setInterval(() => {
      setCurrentSlide((prev) => (prev + 1) % heroSlides.length);
    }, 6000);
    return () => window.clearInterval(timer);
  }, []);

  const activeSlide = heroSlides[currentSlide];

  const trendingItems: TrendingItem[] = useMemo(() => {
    const sources = [
      productCategories[0]?.assets[4],
      productCategories[1]?.assets[1],
      productCategories[0]?.assets[5],
      productCategories[3]?.assets[0],
    ];

    const fallbacks = [
      {
        id: "fallback-1",
        title: "Sculptural Heels",
        description: "Sculpted block silhouettes with satin straps for elevated nights out.",
      },
      {
        id: "fallback-2",
        title: "Archive Denim Jacket",
        description: "Stonewash oversized denim rescued from a 90s archive.",
      },
      {
        id: "fallback-3",
        title: "Forest Cable Knit",
        description: "Soft-touch knit in deep emerald with textured cabling.",
      },
      {
        id: "fallback-4",
        title: "Nordic Ceramic Set",
        description: "Minimal stoneware duo in muted tones for slow mornings.",
      },
    ];

    return sources.map((asset, index) => {
      const fallback = fallbacks[index];
      const previewUrl = asset?.previewUrl ?? trendingFallbacks[index];

      return {
        id: asset?.id ?? fallback.id,
        title: asset?.title ?? fallback.title,
        description: asset?.description ?? fallback.description,
        previewUrl,
        price: ["Rp 295K", "Rp 210K", "Rp 185K", "Rp 95K"][index],
        previous: ["Rp 420K", "Rp 315K", "Rp 275K", "Rp 140K"][index],
        condition: ["Like new", "Preloved", "Like new", "Excellent"][index],
        highlight: ["Editors' pick", "Streetwear drop", "Season fav", "Home edit"][index],
      } satisfies TrendingItem;
    });
  }, []);

  const curatedCollections = [
    {
      title: "Minimalist Wardrobe Reset",
      description: "Neutral layers and clean tailoring inspired by The RealReal's understated drops.",
      image:
        productCategories[0]?.assets[0]?.previewUrl ??
        "https://images.unsplash.com/photo-1595777457583-95e059d581b8?auto=format&fit=crop&w=1200&q=80",
      href: "#",
      tags: ["Neutral Tones", "Smart Casual"],
    },
    {
      title: "Streetwear Essentials",
      description: "Archive tees, boxy denim, and premium sneakers curated with a Depop energy.",
      image:
        productCategories[1]?.assets[1]?.previewUrl ??
        "https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&w=1200&q=80",
      href: "#",
      tags: ["Archive", "Limited Run"],
    },
    {
      title: "Home & Living Finds",
      description: "Aptdeco-inspired statement furniture, ceramics, and mood-setting decor.",
      image:
        productCategories[3]?.assets[0]?.previewUrl ??
        "https://images.unsplash.com/photo-1556910103-1c02745a30bf?auto=format&fit=crop&w=1200&q=80",
      href: "#",
      tags: ["Slow Living", "Vintage Core"],
    },
  ];

  return (
    <div className="relative min-h-screen bg-[#f7f7f5] text-slate-900">
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      />

      <header className="sticky top-0 z-40 border-b border-slate-200/60 glass-effect">
        <div className="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 transition-all duration-500">
          <Link href="/" className="flex items-center gap-3 group">
            <div className="relative h-12 w-12 overflow-hidden rounded-xl border border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-lime-50 shadow-lg group-hover:shadow-xl transition-shadow">
              <img
                src="/logo.svg"
                alt="ThriftMap"
                className="h-full w-full object-contain p-2"
              />
            </div>
            <div className="flex flex-col leading-tight">
              <span className="text-lg font-bold tracking-wide text-transparent bg-gradient-to-r from-emerald-700 to-lime-600 bg-clip-text">
                ThriftMap
              </span>
              <span className="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-600">
                Style More | Spend Less
              </span>
            </div>
          </Link>

          <nav className="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
            <Link href="#categories" className="transition hover:text-emerald-600 hover:-translate-y-1">
              Categories
            </Link>
            <Link href="#trending" className="transition hover:text-emerald-600 hover:-translate-y-1">
              Trending
            </Link>
            <Link href="#collections" className="transition hover:text-emerald-600 hover:-translate-y-1">
              Collections
            </Link>
            <Link href="#impact" className="transition hover:text-emerald-600 hover:-translate-y-1">
              Impact
            </Link>
            <Link href="#" className="transition hover:text-emerald-600 hover:-translate-y-1">
              Stories
            </Link>
          </nav>

          <div className="flex items-center gap-3 text-sm font-medium">
            <Link
              href="/login"
              className="rounded-full border border-slate-300/60 px-5 py-2.5 text-slate-700 transition hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50/50"
            >
              Sign in
            </Link>
            <Link
              href="/login"
              className="rounded-full bg-gradient-to-r from-emerald-600 to-lime-500 px-5 py-2.5 text-white shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5 font-semibold"
            >
              Become a seller
            </Link>
          </div>
        </div>
      </header>

      <main>
        <section className="relative overflow-hidden bg-gradient-to-b from-white to-[#f9fef7]">
          <div
            className="pointer-events-none absolute inset-0 hero-gradient"
            style={{ backgroundImage: activeSlide.accentGradient }}
          />
          <div className="absolute -left-32 top-0 hidden h-80 w-80 rounded-full bg-emerald-200/40 blur-[140px] md:block animate-floating-slow" />
          <div className="absolute -bottom-40 right-[-80px] hidden h-72 w-72 rounded-full bg-lime-300/30 blur-[130px] md:block animate-floating-medium" />
          <div className="absolute left-[10%] top-20 hidden h-32 w-32 rounded-full border-2 border-emerald-200/50 bg-white/40 backdrop-blur md:flex animate-floating-fast" />

          <div className="relative mx-auto grid max-w-6xl gap-12 px-4 py-16 lg:grid-cols-12 lg:py-20">
            <div
              className={`lg:col-span-6 space-y-6 ${
                isMounted ? "animate-in fade-in slide-in-from-left-6 duration-700" : ""
              }`}
            >
              <span className="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.35em] text-emerald-600">
                <span className="h-1.5 w-1.5 rounded-full bg-emerald-600" />
                {activeSlide.eyebrow}
              </span>
              <h1 className="text-3xl font-semibold leading-tight text-slate-900 sm:text-4xl lg:text-[2.75rem]">
                {activeSlide.title}
              </h1>
              <p className="max-w-xl text-base text-slate-600 sm:text-lg">
                {activeSlide.description}
              </p>
              <div className="flex flex-wrap gap-3">
                <Link
                  href={activeSlide.primary.href}
                  className="rounded-full bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-[0_18px_35px_rgba(16,185,129,0.35)] transition hover:-translate-y-0.5 hover:bg-emerald-700"
                >
                  {activeSlide.primary.label}
                </Link>
                <Link
                  href={activeSlide.secondary.href}
                  className="rounded-full border border-slate-200 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-emerald-500 hover:text-emerald-600"
                >
                  {activeSlide.secondary.label}
                </Link>
              </div>
              <div className="grid gap-3 pt-2 sm:grid-cols-2">
                {activeSlide.highlights.map((item) => (
                  <div
                    key={item.label}
                    className="flex items-center gap-3 rounded-2xl border border-emerald-100/60 bg-white/75 px-4 py-3 text-sm font-medium text-slate-700 shadow-[0_10px_30px_rgba(15,76,58,0.08)] backdrop-blur transition hover:-translate-y-0.5"
                  >
                    <span className="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                      <i className={item.icon} />
                    </span>
                    <div>
                      <div className="text-base font-semibold text-emerald-700">{item.value}</div>
                      <div className="text-xs uppercase tracking-[0.3em] text-slate-500">{item.label}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div
              className={`relative lg:col-span-6 ${
                isMounted ? "animate-in fade-in slide-in-from-bottom-6 duration-700 delay-150" : ""
              }`}
            >
              <div className="relative overflow-hidden rounded-[32px] border border-white shadow-[0_20px_60px_rgba(15,76,58,0.22)]">
                <div className="aspect-[4/3] bg-slate-100">
                  <img
                    src={activeSlide.image}
                    alt={activeSlide.title}
                    className="h-full w-full object-cover transition duration-700"
                  />
                </div>
                <div className="absolute inset-4 rounded-[28px] border border-white/70" />
                <div className="absolute bottom-5 left-5 right-5 flex items-center justify-between rounded-3xl bg-white/80 px-4 py-3 text-xs font-semibold uppercase tracking-[0.3em] text-emerald-600 shadow-lg backdrop-blur">
                  <span>Style More</span>
                  <span className="h-5 w-px bg-emerald-100" />
                  <span>Spend Less</span>
                </div>
              </div>
              <div className="mt-6 flex items-center gap-3">
                {heroSlides.map((slide, index) => (
                  <button
                    key={slide.eyebrow}
                    aria-label={`Show slide ${index + 1}`}
                    onClick={() => setCurrentSlide(index)}
                    className={`h-2.5 w-8 rounded-full transition ${
                      index === currentSlide
                        ? "bg-emerald-600"
                        : "bg-slate-200 hover:bg-slate-300"
                    }`}
                  />
                ))}
              </div>
            </div>
          </div>
        </section>

        <div className="border-y border-emerald-100 bg-[#eef6f1]">
          <div className="relative overflow-hidden">
            <div className="marquee-overlay" />
            <div className="marquee-track flex min-w-full gap-10 whitespace-nowrap py-4 text-sm font-semibold uppercase tracking-[0.35em] text-emerald-700">
              {marqueeItems.concat(marqueeItems).map((item, index) => (
                <span key={`${item}-${index}`} className="flex items-center gap-3">
                  {item}
                  <span className="h-1.5 w-1.5 rounded-full bg-emerald-400" />
                </span>
              ))}
            </div>
          </div>
        </div>

        <section id="categories" className="bg-[#eef6f1] py-20">
          <div className="mx-auto max-w-6xl px-4">
            <div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div className="animate-in fade-in slide-in-from-left-6 duration-700">
                <h2 className="text-2xl font-semibold text-slate-900 sm:text-3xl">
                  Shop by category
                </h2>
                <p className="text-sm text-slate-600 sm:text-base">
                  Organised like your favourite resale apps — minus the clutter.
                </p>
              </div>
              <Link
                href="#"
                className="text-sm font-medium text-emerald-700 transition hover:text-emerald-800"
              >
                View all categories
              </Link>
            </div>

            <div className="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {productCategories.map((category, index) => {
                const primaryAsset = category.assets[0] ?? category.assets[1];
                return (
                  <Link
                    key={category.id}
                    href="#"
                    className="group flex h-full flex-col justify-between rounded-3xl border border-slate-100/70 bg-white p-6 shadow-[0_12px_35px_rgba(15,76,58,0.08)] transition-all duration-500 hover:border-emerald-200 hover:shadow-[0_25px_65px_rgba(15,76,58,0.15)] hover:card-hover"
                  >
                    <div className="animate-in fade-in slide-in-from-bottom-4 duration-500">
                      <div className="aspect-[4/3] overflow-hidden rounded-2xl bg-gradient-to-br from-slate-100 to-slate-200">
                        <img
                          src={
                            primaryAsset?.previewUrl ??
                            `https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=1200&q=80&sat=${90 + index * 3}`
                          }
                          alt={primaryAsset?.title ?? category.category}
                          className="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                        />
                      </div>
                      <h3 className="mt-5 text-lg font-bold text-slate-900">
                        {category.category}
                      </h3>
                      <p className="mt-2 text-sm text-slate-600 line-clamp-2">
                        {category.subcategories.join(" • ")}
                      </p>
                    </div>
                    <span className="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 group-hover:gap-3 transition-all">
                      Explore <i className="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1" />
                    </span>
                  </Link>
                );
              })}
            </div>
          </div>
        </section>

        <section id="trending" className="bg-gradient-to-b from-white via-[#fdfdfb] to-[#eef6f1] py-20">
          <div className="mx-auto max-w-6xl px-4">
            <div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div className="animate-in fade-in slide-in-from-left-6 duration-700">
                <h2 className="text-2xl font-semibold text-slate-900 sm:text-3xl">
                  Trending drops right now
                </h2>
                <p className="text-sm text-slate-600 sm:text-base">
                  Smart deals curated by our editors — refreshes every Friday.
                </p>
              </div>
              <Link
                href="#"
                className="text-sm font-medium text-emerald-700 transition hover:text-emerald-800"
              >
                See full drop
              </Link>
            </div>

            <div className="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {trendingItems.map((item, index) => (
                <div
                  key={item.id}
                  className="group flex h-full flex-col rounded-3xl border border-slate-100/60 bg-white/95 p-5 shadow-[0_16px_45px_rgba(15,76,58,0.1)] backdrop-blur-sm transition-all duration-500 hover:border-emerald-200/80 hover:bg-white hover:shadow-[0_28px_70px_rgba(15,76,58,0.2)] hover:card-hover"
                  style={{ animationDelay: `${index * 100}ms` }}
                >
                  <div className="relative aspect-[4/3] overflow-hidden rounded-2xl bg-gradient-to-br from-slate-100 to-slate-200">
                    <img
