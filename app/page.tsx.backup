interface HeroSlide {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  accentGradient: string;
  highlights: Array<{ value: string; label: string; icon: string }>;
}

interface TrendingItem {
  id: string;
  title: string;
  description: string;
  previewUrl: string;
  price: string;
  previous: string;
  condition: string;
  highlight: string;
}

const heroSlides: HeroSlide[] = [
  {
    eyebrow: "NEW THIS WEEK",
    title: "Elevated sneakers curated for a rotation that actually feels new.",
    description:
      "Authenticated styles from local tastemakers. Limited pairs drop every Friday with prices starting at Rp 280K.",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1600&q=80",
    primary: { label: "Shop sneakers", href: "#trending" },
    secondary: { label: "See collections", href: "#collections" },
