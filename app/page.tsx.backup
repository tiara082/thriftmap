                    <span className="text-xs font-semibold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">
                      {item.condition}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section className="bg-[#fbfdfb] py-20">
          <div className="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-[1.1fr_1fr]">
            <div className="animate-in fade-in slide-in-from-left-6 duration-700">
              <h2 className="text-2xl font-semibold text-slate-900 sm:text-3xl">
                Price filters for every thrifter
