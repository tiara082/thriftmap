                        {tier.label}
                      </h3>
                      <span className="text-sm font-medium text-emerald-700">
                        {tier.price}
                      </span>
                    </div>
                    <p className="mt-3 text-sm text-slate-600">{tier.description}</p>
                  </div>
                ))}
              </div>
            </div>

            <div className="flex flex-col justify-center rounded-[32px] border border-emerald-100 bg-white p-8 shadow-[0_24px_60px_rgba(15,76,58,0.12)] animate-in fade-in slide-in-from-right-6 duration-700">
              <span className="text-xs font-semibold uppercase tracking-[0.35em] text-emerald-600">
                How it works
              </span>
              <h3 className="mt-4 text-2xl font-semibold text-slate-900">
                Resale reimagined for Gen Z thrifters
              </h3>
              <div className="mt-8 space-y-6">
                {howItWorks.map((item, index) => (
                  <div key={item.title} className="flex gap-4" style={{ animationDelay: `${index * 120}ms` }}>
                    <span className="mt-1 flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
                      <i className={item.icon} />
                    </span>
                    <div>
                      <h4 className="text-base font-semibold text-slate-900">
                        {item.title}
                      </h4>
                      <p className="text-sm text-slate-600">{item.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section id="collections" className="bg-white py-20">
          <div className="mx-auto max-w-6xl px-4">
            <div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div className="animate-in fade-in slide-in-from-left-6 duration-700">
                <h2 className="text-2xl font-semibold text-slate-900 sm:text-3xl">
                  Curated collections
                </h2>
                <p className="text-sm text-slate-600 sm:text-base">
                  Inspirations pulled straight from your saves — refreshed weekly.
                </p>
              </div>
              <Link
                href="#"
                className="text-sm font-medium text-emerald-700 transition hover:text-emerald-800"
              >
                Explore editor picks
              </Link>
            </div>

            <div className="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {curatedCollections.map((collection, index) => (
                <Link
                  key={collection.title}
                  href={collection.href}
                  className="group flex h-full flex-col rounded-[28px] border border-slate-100 bg-[#fdfdfb]/90 p-6 shadow-[0_20px_55px_rgba(15,76,58,0.1)] transition hover:-translate-y-1 hover:border-emerald-100 hover:bg-white hover:shadow-[0_26px_65px_rgba(15,76,58,0.16)]"
                  style={{ animationDelay: `${index * 140}ms` }}
                >
                  <div className="aspect-[4/3] overflow-hidden rounded-2xl bg-slate-100">
                    <img
                      src={collection.image}
                      alt={collection.title}
                      className="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                  </div>
                  <div className="mt-5 flex-1">
                    <div className="flex flex-wrap gap-2">
                      {collection.tags.map((tag) => (
                        <span
                          key={tag}
                          className="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700"
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                    <h3 className="mt-4 text-lg font-semibold text-slate-900">
                      {collection.title}
                    </h3>
                    <p className="mt-2 text-sm text-slate-600">{collection.description}</p>
                  </div>
                  <span className="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700">
                    View the edit <i className="fa-solid fa-arrow-right text-xs" />
                  </span>
                </Link>
              ))}
            </div>
          </div>
        </section>

        <section id="impact" className="bg-[#eff8f2] py-20">
          <div className="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[1fr_1.1fr]">
            <div className="flex flex-col justify-center rounded-[32px] border border-emerald-100 bg-white p-8 shadow-[0_24px_60px_rgba(15,76,58,0.12)] animate-in fade-in slide-in-from-left-6 duration-700">
              <span className="text-xs font-semibold uppercase tracking-[0.35em] text-emerald-600">
                Why it matters
              </span>
              <h2 className="mt-4 text-2xl font-semibold text-slate-900 sm:text-3xl">
                Circular fashion with measurable impact
              </h2>
              <p className="mt-4 text-sm text-slate-600 sm:text-base">
                Every purchase keeps garments out of landfills and supports local sellers. Track your personal impact in real time and celebrate your wins with the ThriftMap community.
              </p>

              <div className="mt-8 grid gap-4 sm:grid-cols-2">
                {communityHighlights.map((item) => (
                  <div
                    key={item.label}
                    className="rounded-3xl border border-slate-100 bg-[#f6fbf8] p-6 text-center shadow-[0_18px_45px_rgba(15,76,58,0.08)]"
                  >
                    <div className="text-3xl font-semibold text-emerald-700">
                      {item.value}
                    </div>
                    <p className="mt-2 text-sm font-medium text-slate-600">
                      {item.label}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <div className="space-y-6 animate-in fade-in slide-in-from-right-6 duration-700">
              <div className="rounded-[28px] border border-transparent bg-gradient-to-br from-emerald-600 via-emerald-500 to-lime-400 p-[1px] shadow-[0_24px_60px_rgba(16,185,129,0.25)]">
                <div className="rounded-[26px] bg-white p-8">
                  <h3 className="text-xl font-semibold text-slate-900">
                    Join the impact newsletter
                  </h3>
                  <p className="mt-3 text-sm text-slate-600">
                    Weekly drops, styling prompts, and sustainability stats designed for Gen Z thrifters. No spam, just fire fits.
                  </p>
                  <form className="mt-6 flex flex-col gap-3 sm:flex-row">
                    <input
                      type="email"
                      placeholder="Your email"
                      className="h-12 flex-1 rounded-full border border-slate-200 bg-white px-5 text-sm text-slate-700 outline-none transition focus:border-emerald-500"
                    />
                    <button
                      type="submit"
                      className="h-12 rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700"
                    >
                      Subscribe
                    </button>
                  </form>
                  <p className="mt-3 text-xs text-slate-500">
                    By subscribing, you agree to receive curated updates and community highlights. You can unsubscribe any time.
                  </p>
                </div>
              </div>

              <div className="rounded-[28px] border border-slate-100 bg-white p-6 shadow-[0_24px_55px_rgba(15,76,58,0.1)]">
                <h3 className="text-lg font-semibold text-slate-900">
                  Community shout-outs
                </h3>
                <div className="mt-4 space-y-4 text-sm text-slate-600">
                  <p>
                    "ThriftMap helped me build a capsule wardrobe in under a month. The impact tracker keeps me accountable."
                    <span className="ml-2 text-xs text-slate-400">— @selahfits</span>
                  </p>
                  <p>
                    "Certified sellers, moodboard-worthy imagery, and deals that actually feel fair. Instant favourite."
                    <span className="ml-2 text-xs text-slate-400">— @depopdad</span>
                  </p>
                  <p>
                    "Sold out my apartment refresh in 48 hours. The listing flow is chef's kiss."
                    <span className="ml-2 text-xs text-slate-400">— @aptdeco.id</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section className="bg-white py-20">
          <div className="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-2">
            <div className="flex flex-col justify-center animate-in fade-in slide-in-from-left-6 duration-700">
              <span className="text-xs font-semibold uppercase tracking-[0.35em] text-emerald-600">
                ThriftMap app
              </span>
              <h2 className="mt-4 text-2xl font-semibold text-slate-900 sm:text-3xl">
                Keep the marketplace in your pocket
              </h2>
              <p className="mt-4 max-w-lg text-sm text-slate-600 sm:text-base">
                Drop alerts, saved search notifications, and seller tools are even faster on mobile. Build collections on the commute and close offers instantly.
              </p>
              <div className="mt-6 flex flex-wrap gap-3">
                <button className="flex items-center gap-3 rounded-full border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-emerald-500 hover:text-emerald-600">
                  <i className="fa-brands fa-apple text-lg" />
                  App Store
                </button>
                <button className="flex items-center gap-3 rounded-full border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-emerald-500 hover:text-emerald-600">
                  <i className="fa-brands fa-google-play text-lg" />
                  Play Store
                </button>
              </div>
              <div className="mt-6 grid gap-4 sm:grid-cols-2">
                {appFeatures.map((feature, index) => (
                  <div
                    key={feature.title}
                    className="rounded-2xl border border-slate-100 bg-[#f9fcfa] p-5 shadow-[0_18px_45px_rgba(15,76,58,0.08)]"
                    style={{ animationDelay: `${index * 120}ms` }}
                  >
                    <span className="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
                      <i className={feature.icon} />
                    </span>
                    <h3 className="mt-4 text-base font-semibold text-slate-900">
                      {feature.title}
                    </h3>
                    <p className="mt-2 text-sm text-slate-600">
                      {feature.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <div className="relative flex items-center justify-center animate-in fade-in slide-in-from-right-6 duration-700">
              <div className="relative h-[520px] w-[300px] overflow-hidden rounded-[48px] border-4 border-emerald-500 bg-black shadow-[0_30px_80px_rgba(15,76,58,0.25)]">
                <img
                  src="https://images.unsplash.com/photo-1545239351-1141bd82e8a6?auto=format&fit=crop&w=900&q=80"
                  alt="ThriftMap app preview"
                  className="h-full w-full object-cover"
                />
                <div className="absolute inset-x-6 bottom-6 rounded-3xl bg-white/90 p-4 text-center text-xs font-medium text-slate-700 shadow-[0_12px_35px_rgba(15,76,58,0.15)]">
                  Create listings in 90 seconds with auto-tag suggestions.
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer className="border-t border-slate-200 bg-[#f7f7f5]">
        <div className="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:grid-cols-[1.2fr_1fr_1fr]">
          <div>
            <Link href="/" className="flex items-center gap-3">
              <div className="relative h-12 w-12 overflow-hidden rounded-xl border border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-lime-50">
                <img
                  src="/logo.svg"
                  alt="ThriftMap"
                  className="h-full w-full object-contain p-2"
                />
              </div>
              <div className="flex flex-col leading-tight">
                <span className="text-lg font-semibold tracking-wide text-emerald-700">
                  ThriftMap
                </span>
                <span className="text-xs font-medium uppercase tracking-[0.22em] text-emerald-500">
                  Style More | Spend Less
                </span>
              </div>
            </Link>
            <p className="mt-4 max-w-sm text-sm text-slate-600">
              ThriftMap is the conscious marketplace for preloved fashion, decor, and lifestyle finds. Buy, sell, and style better together.
            </p>
            <div className="mt-6 flex gap-3 text-slate-500">
              <a href="#" aria-label="Instagram" className="transition hover:text-emerald-600">
                <i className="fa-brands fa-instagram text-xl" />
              </a>
              <a href="#" aria-label="TikTok" className="transition hover:text-emerald-600">
                <i className="fa-brands fa-tiktok text-xl" />
              </a>
              <a href="#" aria-label="YouTube" className="transition hover:text-emerald-600">
                <i className="fa-brands fa-youtube text-xl" />
              </a>
            </div>
          </div>

          <div className="grid gap-6 text-sm text-slate-600 sm:grid-cols-2">
            <div>
              <h3 className="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">
                Shop
              </h3>
              <ul className="mt-4 space-y-3">
                <li>
                  <Link href="#categories" className="transition hover:text-emerald-600">
                    Categories
                  </Link>
                </li>
                <li>
                  <Link href="#trending" className="transition hover:text-emerald-600">
                    Trending drops
                  </Link>
                </li>
                <li>
                  <Link href="#collections" className="transition hover:text-emerald-600">
                    Curated edits
                  </Link>
                </li>
                <li>
                  <Link href="#impact" className="transition hover:text-emerald-600">
                    Impact tracker
                  </Link>
                </li>
              </ul>
            </div>
            <div>
              <h3 className="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">
                Sell
              </h3>
              <ul className="mt-4 space-y-3">
                <li>
                  <Link href="/login" className="transition hover:text-emerald-600">
                    Become a seller
                  </Link>
                </li>
                <li>
                  <Link href="/login" className="transition hover:text-emerald-600">
                    Seller dashboard
                  </Link>
                </li>
                <li>
                  <a href="#" className="transition hover:text-emerald-600">
                    Pricing & fees
                  </a>
                </li>
                <li>
                  <a href="#" className="transition hover:text-emerald-600">
                    Seller stories
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div className="text-sm text-slate-600">
            <h3 className="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">
              Stay in the loop
            </h3>
            <p className="mt-4 text-sm">
              Get curated drops, styling inspo, and community spotlights every week.
            </p>
            <form className="mt-4 flex flex-col gap-3">
              <input
                type="email"
                placeholder="name@email.com"
                className="h-11 rounded-full border border-slate-200 bg-white px-5 text-sm text-slate-700 outline-none transition focus:border-emerald-500"
              />
              <button
                type="submit"
                className="h-11 rounded-full bg-emerald-600 font-semibold text-white transition hover:bg-emerald-700"
              >
                Subscribe
              </button>
            </form>
            <p className="mt-3 text-xs text-slate-500">
              We'll never share your email. Unsubscribe anytime.
            </p>
          </div>
        </div>
      </footer>
    </div>
  );
}
