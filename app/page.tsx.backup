    accentGradient:
      "radial-gradient(120% 120% at 50% 0%, rgba(217,249,157,0.25) 0%, rgba(74,222,128,0.15) 45%, rgba(255,255,255,0) 85%)",
    highlights: [
      { value: "Top 1%", label: "Seller tier", icon: "fa-solid fa-crown" },
      { value: "Hi-res", label: "Moodboard shots", icon: "fa-solid fa-camera-retro" },
      { value: "3 day", label: "Listing turnover", icon: "fa-regular fa-bolt" },
    ],
  },
  {
    eyebrow: "GREEN IS THE NEW BLACK",
    title: "Every resale keeps textile waste out of landfills — style more, spend less.",
    description:
      "Join 52K+ thrifters choosing preloved first. Track your CO₂ savings and build a wardrobe you actually wear.",
    image: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1600&q=80",
    primary: { label: "Start thrifting", href: "#impact" },
    secondary: { label: "Why secondhand", href: "#impact" },
    accentGradient:
      "radial-gradient(120% 120% at 50% 0%, rgba(45,212,191,0.28) 0%, rgba(16,185,129,0.1) 55%, rgba(255,255,255,0) 90%)",
    highlights: [
      { value: "7.8T g", label: "CO₂ saved", icon: "fa-solid fa-leaf" },
      { value: "68%", label: "Repeat buyers", icon: "fa-regular fa-face-smile" },
      { value: "52K", label: "Community", icon: "fa-solid fa-people-group" },
    ],
  },
];

const priceFilters = [
  {
    label: "Under 50K",
    description: "Curated staples for everyday fits, handpicked by our community stylists.",
    price: "Mulai 25K",
    accent: "bg-[#dcfce7]",
  },
  {
    label: "50K - 150K",
    description: "Mix-and-match layers, denim, and outerwear for smarter weekday looks.",
    price: "Mulai 65K",
    accent: "bg-[#bbf7d0]",
  },
  {
    label: "150K+",
    description: "Designer edits, one-off statement pieces, and collectors' drops.",
    price: "Mulai 185K",
